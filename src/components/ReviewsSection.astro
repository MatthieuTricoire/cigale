---
import ReviewCard from './ui/ReviewCard.astro'

const reviews = [
  {
    name: "Sophie Martin",
    comment: "Cédric a été d'une aide précieuse pour structurer notre projet immobilier. Son expertise et sa disponibilité ont fait toute la différence. Je recommande fortement !"
  },
  {
    name: "Philippe Dubois",
    comment: "Un professionnel rigoureux et à l'écoute. Il a su trouver des solutions adaptées à ma situation pour optimiser ma fiscalité. Très satisfait de l'accompagnement."
  },
  {
    name: "Marie Lefebvre",
    comment: "Suite à notre rencontre, j'ai pu enfin comprendre mes options pour la retraite. Cédric prend le temps d'expliquer chaque étape. Un vrai partenariat dans la durée."
  },
  {
    name: "Jean-Michel Bernard",
    comment: "Excellente gestion de notre patrimoine familial. Conseils avisés, transparence et suivi régulier. Nous lui faisons confiance pour tous nos projets financiers."
  },
  {
    name: "Catherine Roux",
    comment: "Suite au décès de mon mari, j'étais perdue concernant la gestion de notre patrimoine. Cédric a fait preuve d'une grande empathie et m'a guidée avec professionnalisme."
  },
  {
    name: "Nicolas Mercier",
    comment: "Transparence totale sur les frais, conseils objectifs et personnalisés. Un accompagnement qui va au-delà de la simple gestion de placements."
  },
  {
    name: "Olivier Petit",
    comment: "Premier rendement après 6 mois d'accompagnement. Résultats conformes aux attentes. Un suivi rigoureux et des conseils pertinents."
  },
  {
    name: "Isabelle Moreau",
    comment: "Contact rapide et réponse à toutes mes questions. Accompagnement de qualité pour la transmission de notre patrimoine."
  },
  {
    name: "Thierry Garnier",
    comment: "Aide précieuse pour la création d'un contrat d'assurance vie. Expertise pointue et explications claires."
  },
  {
    name: "Valérie Lambert",
    comment: "Cédric a su nous accompagner dans l'achat de notre résidence principale avec un montage financier optimal."
  },
  {
    name: "François Martin",
    comment: "Portfolio diversifié et équilibré grâce à ses conseils. Suivi annuel rigoureux et propositions d'ajustement pertinentes."
  },
  {
    name: "Sandrine Moreau",
    comment: "Conseiller à l'écoute et disponible. Un accompagnement sur le long terme vraiment précieux pour notre famille."
  },
  {
    name: "Jean-Claude L",
    comment: "Très précis dans ces explanations et à l'écoute."
  }
]

function chunkArray<T>(array: T[], size: number): T[][] {
  const result: T[][] = []
  for (let i = 0; i < array.length; i += size) {
    result.push(array.slice(i, i + size))
  }
  return result
}

const reviewGroupsMobile = chunkArray(reviews, 2)
const reviewGroupsTablet = chunkArray(reviews, 2)
const reviewGroupsDesktop = chunkArray(reviews, 3)
const totalPagesDesktop = reviewGroupsDesktop.length
---

<section id="reviews" class="py-24 scroll-mt-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h3 class="text-center font-serif text-2xl text-primary underline underline-offset-8 mb-4">Témoignages</h3>
      <h2 class="font-serif text-4xl text-sage mb-4 flex justify-center">Ce que mes clients disent</h2>
      <p class="text-sage/60 max-w-2xl mx-auto">La satisfaction de mes clients est ma plus belle récompense. Voici quelques retours d'expérience qui témoignent de la qualité de mon accompagnement.</p>
    </div>

    <div class="relative">
<div id="reviews-carousel" class="overflow-hidden">
        <div class="flex transition-transform duration-500 ease-in-out" data-carousel>
          {reviewGroupsDesktop.map((group, groupIndex) => (
            <div class="w-full flex-shrink-0 px-2 md:px-3" data-group-index={groupIndex}>
              <div class="flex flex-col gap-4 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-6 [&>*:nth-child(3)]:hidden md:[&>*:nth-child(3)]:block">
                {group.map((review) => (
                  <ReviewCard name={review.name} comment={review.comment} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-center items-center gap-4 mt-8">
        <button
          id="prev-btn"
          class="p-3 rounded-full border border-sage/20 text-sage hover:bg-sage/10 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
          aria-label="Avis précédent"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <span id="carousel-indicator" class="text-sage/60 text-sm">
          <span id="current-page">1</span> / <span id="total-pages">{totalPagesDesktop}</span>
        </span>
        <button
          id="next-btn"
          class="p-3 rounded-full border border-sage/20 text-sage hover:bg-sage/10 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
          aria-label="Avis suivant"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ totalPagesDesktop: reviewGroupsDesktop.length, totalReviews: reviews.length }}>
  const carousel = document.querySelector('[data-carousel]');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const currentPageEl = document.getElementById('current-page');
  const totalPagesEl = document.getElementById('total-pages');
  
  let currentPage = 1;

  function getItemsPerPage() {
    const width = window.innerWidth;
    if (width < 768) return 2;
    if (width < 1024) return 2;
    return 3;
  }

  function getTotalGroups() {
    return Math.ceil(totalReviews / getItemsPerPage());
  }

  function updateCarousel() {
    const totalGroups = getTotalGroups();
    totalPagesEl.textContent = totalGroups;
    currentPageEl.textContent = currentPage;
    
    const offset = (currentPage - 1) * 100;
    carousel.style.transform = `translateX(-${offset}%)`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalGroups;
  }

  prevBtn?.addEventListener('click', () => {
    const totalGroups = getTotalGroups();
    if (currentPage > 1) {
      currentPage--;
      updateCarousel();
    }
  });

  nextBtn?.addEventListener('click', () => {
    const totalGroups = getTotalGroups();
    if (currentPage < totalGroups) {
      currentPage++;
      updateCarousel();
    }
  });

  window.addEventListener('resize', () => {
    const totalGroups = getTotalGroups();
    if (currentPage > totalGroups) {
      currentPage = totalGroups;
    }
    if (currentPage < 1) currentPage = 1;
    updateCarousel();
  });

  updateCarousel();
</script>