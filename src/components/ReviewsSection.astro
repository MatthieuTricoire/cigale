---
import ReviewCard from './ui/ReviewCard.astro'

const reviewsUnsorted = [
  {
    firstname1: "Béatrice",
    lastname: "C",
    comment: "Cédric est un conseiller en patrimoine très disponible, très à l'écoute. Il explique très clairement les différentes possibilités d'investissement, ce qui me permet de choisir en toute connaissance de cause. Il conseille sans influencer. On se sent à l'aise. Il fait preuve de beaucoup de patience et de compétences. C'est un professionnel très investi qui propose un accompagnement sur mesure.",
    date:"02/04/2026",
    age:62,
  },
  {
    firstname1: "Jean-Claude",
    firstname2: "Véronique",
    lastname: "L",
    date: "06/03/2026",
    age: 63,
    age2: 59,
    comment: "Très précis dans ces explications et à l'écoute."
  },
  {
    firstname1: "Mathieu",
    lastname: "N",
    date:"08/12/2025",
    age: 39,
    comment: "Je connais Cédric depuis longtemps et son approche rigoureuse et pédagogique est très adaptée. Les stratégies mises en place se sont traduites rapidement par des résultats concrets, conformes aux objectifs annoncés. Je recommande son accompagnement à toute personne recherchant efficacité et transparence."
  },
  {
    firstname1: "Thierry",
    lastname: "R",
    date: "03/09/2025",
    age: 66,
    comment: "Très sympathique, à l'écoute, explication claire et de très bon conseil."
  },
  {
    firstname1: "Sylvie",
    lastname: "G",
    date: "07/01/2025",
    age: 63,
    comment: "Dans le cadre de la gestion de mon patrimoine et mon manque d'informations sur ce sujet, Cédric a su m'expliquer avec des phrases simples les différentes possibilités qui s'offraient à moi dans ma situation et sans chercher à me pousser à souscrire. J'ai suivi ces conseils sur la mise en place des solutions en toute confiance. Merci pour sa patience, son écoute, sa clarté et sa gentillesse."
  },
  {
    firstname1: "Laetitia",
    lastname: "G",
    age: 35,
    date: "07/01/2025",
    comment: "Excellent conseiller, toujours disponible et à l'écoute. Ses conseils sont clairs et adaptés à ma situation et mes envies. Je me sens vraiment en confiance. Merci pour votre accompagnement et votre efficacité !"
  },
  {
    firstname1: "Anthony",
    lastname: "R",
    date: "27/11/2024",
    age: 28,
    comment: "Grâce à mon conseiller en patrimoine, je mets plus d'argent de côté et je fais attention à mes dépenses. Cédric est disponible, attentif et à l'écoute."
  },
]

function parseDate(dateStr: string): Date {
  const [day, month, year] = dateStr.split('/').map(Number)
  return new Date(year, month - 1, day)
}

const reviews = [...reviewsUnsorted].sort((a, b) => {
  if (a.date && b.date) return parseDate(b.date).getTime() - parseDate(a.date).getTime()
  if (a.date) return -1
  if (b.date) return 1
  return 0
})

function chunkArray<T>(array: T[], size: number): T[][] {
  const result: T[][] = []
  for (let i = 0; i < array.length; i += size) {
    result.push(array.slice(i, i + size))
  }
  return result
}

const reviewGroupsMobile = chunkArray(reviews, 2)
const reviewGroupsTablet = chunkArray(reviews, 2)
const reviewGroupsDesktop = chunkArray(reviews, 3)
const totalPagesDesktop = reviewGroupsDesktop.length
---

<section id="reviews" class="py-24 scroll-mt-2 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h3 class="text-center font-serif text-2xl text-primary underline underline-offset-8 mb-4">Témoignages</h3>
      <h2 class="font-serif text-4xl text-sage mb-4 flex justify-center">Ce que mes clients disent</h2>
      <p class="text-sage/60 max-w-2xl mx-auto">La satisfaction de mes clients est ma plus belle récompense. Voici quelques retours de mes accompagnements.</p>
    </div>

    <div class="relative">
<div id="reviews-carousel" class="overflow-hidden">
        <div class="flex transition-transform duration-500 ease-in-out" data-carousel>
          {reviewGroupsDesktop.map((group, groupIndex) => (
            <div class="w-full flex-shrink-0 px-2 md:px-3" data-group-index={groupIndex}>
              <div class="flex flex-col gap-4 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-6">
                {group.map((review) => (
                  <ReviewCard firstname1={review.firstname1} firstname2={review.firstname2} lastname={review.lastname} comment={review.comment} age={review.age} age2={review.age2} date={review.date} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-center items-center gap-4 mt-8">
        <button
          id="prev-btn"
          class="p-3 rounded-full border border-sage/20 text-sage hover:bg-sage/10 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
          aria-label="Avis précédent"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <span id="carousel-indicator" class="text-sage/60 text-sm">
          <span id="current-page">1</span> / <span id="total-pages">{totalPagesDesktop}</span>
        </span>
        <button
          id="next-btn"
          class="p-3 rounded-full border border-sage/20 text-sage hover:bg-sage/10 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
          aria-label="Avis suivant"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ totalPagesDesktop: reviewGroupsDesktop.length, totalReviews: reviews.length }}>
  const carousel = document.querySelector('[data-carousel]');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const currentPageEl = document.getElementById('current-page');
  const totalPagesEl = document.getElementById('total-pages');
  
  let currentPage = 1;

  function getItemsPerPage() {
    const width = window.innerWidth;
    if (width < 768) return 2;
    if (width < 1024) return 2;
    return 3;
  }

  function getTotalGroups() {
    return Math.ceil(totalReviews / getItemsPerPage());
  }

  function updateCarousel() {
    const totalGroups = getTotalGroups();
    totalPagesEl.textContent = totalGroups;
    currentPageEl.textContent = currentPage;
    
    const offset = (currentPage - 1) * 100;
    carousel.style.transform = `translateX(-${offset}%)`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalGroups;
  }

  prevBtn?.addEventListener('click', () => {
    const totalGroups = getTotalGroups();
    if (currentPage > 1) {
      currentPage--;
      updateCarousel();
    }
  });

  nextBtn?.addEventListener('click', () => {
    const totalGroups = getTotalGroups();
    if (currentPage < totalGroups) {
      currentPage++;
      updateCarousel();
    }
  });

  window.addEventListener('resize', () => {
    const totalGroups = getTotalGroups();
    if (currentPage > totalGroups) {
      currentPage = totalGroups;
    }
    if (currentPage < 1) currentPage = 1;
    updateCarousel();
  });

  updateCarousel();

  const expandButtons = document.querySelectorAll('[data-expand-btn]')
  expandButtons.forEach((btn) => {
    const text = btn.previousElementSibling
    if (text && text.scrollHeight > text.clientHeight) {
      btn.classList.remove('hidden')
      btn.addEventListener('click', () => {
        const isExpanded = text.classList.toggle('line-clamp-4')
        btn.textContent = isExpanded ? 'Lire la suite' : 'Réduire'
      })
    }
  })
</script>
