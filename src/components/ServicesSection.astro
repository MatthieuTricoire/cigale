---
import { Icon } from 'astro-icon/components'

const services = [
  {
    title: "Préparer sa retraite",
    description: "Construire un complément de revenu fiable pour vivre sans dépendre des aléas du système.",
    // Code SVG de l'icône TreePine
    iconPaths: `<path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.8 1.7H17Z" /><path d="M12 22v-3" />`
  },
  {
    title: "Réduire ses impôts",
    description: "Optimiser sa fiscalité légalement, avec des stratégies adaptées à votre profil.",
    iconName: "hugeicons:chart-decrease"
  },
  {
    title: "Financer les études",
    description: "Anticiper les dépenses pour offrir à vos enfants toutes les chances de réussir.",
    iconName: "ph:student"
  },
  {
    title: "Valoriser son épargne",
    description: "Faire fructifier vos économies avec un couple rendement / risque bien calibré.",
    iconName: "ph:piggy-bank"
  },
  {
    title: "Protéger sa famille",
    description: "Sécuriser l'avenir de vos proches face aux imprévus de la vie.",
    iconName: "ph:umbrella-simple"
  },
  {
    title: "Investir dans l'immobilier",
    description: "Construire un patrimoine solide avec les bonnes stratégies d'acquisition.",
    iconName: "hugeicons:home-12"
  }
,
  {
    title: "Financer un grand projet",
    description: "Planifier sereinement un voyage, une résidence secondaire ou un projet personnel.",
    iconName: "hugeicons:tree-palm"
  },
  {
    title: "Transmettre son patrimoine",
    description: "Organiser la transmission de vos biens dans les meilleures conditions fiscales.",
    iconName: "healthicons:child-care-outline"
  },
  {
    title: "Réorganiser son patrimoine",
    description: "Réadapter l'organisation, la stratégie et les solutions mises en place.",
    iconName: "ph:shuffle"
  }
];
---

<section id="services" class="py-24 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h3 class="flex items-center justify-center gap-4 font-serif text-2xl text-primary  mb-4">
        <span class="block flex-1 h-px bg-sage/60"></span>
  Mes services
        <span class="block flex-1 h-px bg-sage/60"></span>
</h3>
<h2 class="font-serif text-4xl text-sage mb-4">La <span class="text-gold italic">gestion personnalisée </span>de votre patrimoine</h2>
<p class="text-sage/60 max-w-2xl mx-auto">Construire son patrimoine, c’est comme cultiver un jardin : il faut semer avec intention, en fonction de vos objectifs et de votre terre. Je ne propose jamais de solutions toutes faites, mais une stratégie sur mesure, afin que vos efforts portent leurs fruits, que vous en récoltiez les bénéfices et que cette abondance se transmette aux générations suivantes.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3  gap-4 md:gap-8">
      {services.map((service) => (
        <div class="bg-white p-8 rounded-xl shadow-sm border border-sage/5">
          
          <div class="w-14 h-14 bg-beige rounded-lg flex items-center justify-center mb-6">
            {service.iconName ? (
              <Icon name={service.iconName} class="text-gold w-7 h-7" />
            ) : (
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                class="text-gold w-7 h-7"
                set:html={service.iconPaths}
              />
            )}
          </div>
          
          <h3 class="font-serif text-xl text-sage mb-3">{service.title}</h3>
          <p class="text-sage/70 text-sm leading-relaxed">{service.description}</p>
          
        </div>
      ))}
    </div>
  </div>
</section>
