---
interface Props {
  question: string
  answer: string | string[]
}

const { question, answer } = Astro.props
---

<details class="group rounded-lg border border-gray-200 bg-white text-left">
  <summary class="flex rounded-lg cursor-pointer list-none items-center justify-between gap-2 p-4 font-medium text-gray-900 transition-colors hover:bg-gray-50 text-wrap-balance [&_svg]:shrink-0">
    {question}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4 transition-transform group-open:rotate-180"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <div class="p-4 pt-0 text-gray-600 text-justify">
    {Array.isArray(answer) ? (
      <ul class="list-disc list-inside space-y-1">
        {answer.map((item) => <li>{item}</li>)}
      </ul>
    ) : (
      <p >{answer}</p>
    )}
  </div>
</details>
