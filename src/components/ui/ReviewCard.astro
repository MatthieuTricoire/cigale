---
interface Props {
  firstname1: string
  firstname2?: string
  lastname: string
  comment: string
  age?: number
  age2?: number
  date?: string
}

const { firstname1, firstname2, lastname, comment, age, age2, date } = Astro.props
const isCouple = !!firstname2

let displayName: string
let avatarInitials: string
if (isCouple) {
  const lastInitial = lastname.charAt(0).toUpperCase()
  displayName = `${firstname1} & ${firstname2} ${lastInitial}.`
  avatarInitials = `${firstname1.charAt(0)}${firstname2!.charAt(0)}`
} else {
  const lastInitial = lastname.charAt(0).toUpperCase()
  displayName = `${firstname1} ${lastInitial}.`
  avatarInitials = firstname1.charAt(0)
}
---

<div class="bg-white rounded-xl p-6 shadow-sm border border-sage/10 hover:shadow-md transition-shadow flex flex-col h-full justify-between">
  <div>
    <div class="flex gap-1 mb-4">
      {[...Array(5)].map(() => (
        <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>
    <p data-expandable class="text-sage/80 leading-relaxed line-clamp-4 text-justify">&ldquo;{comment}&rdquo;</p>
    <button data-expand-btn class="text-primary text-sm font-medium hover:underline mt-2 hidden self-end">Lire la suite</button>
  </div>
  <div class="flex items-center gap-3 pt-4">
    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
      <span class="text-primary font-semibold text-sm">{avatarInitials}</span>
    </div>
    <div>
      <p class="font-medium text-sage">{displayName}</p>
      <p class="text-xs text-sage/50">
        {isCouple && age && age2 ? `${age} & ${age2} ans` : age ? `${age} ans` : ''}
        {age && date && " · "}
        {date && date}
      </p>
    </div>
  </div>
</div>

